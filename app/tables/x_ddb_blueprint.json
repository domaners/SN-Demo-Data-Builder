{
  "name": "x_ddb_blueprint",
  "label": "Blueprint",
  "plural": "Blueprints",
  "display": "name",
  "columns": [
    { "name": "name", "label": "Name", "type": "string", "max_length": 120 },
    { "name": "scenario", "label": "Scenario", "type": "reference", "reference": "x_ddb_scenario", "mandatory": true },
    { "name": "version", "label": "Version", "type": "integer", "read_only": true },
    { "name": "state", "label": "State", "type": "choice", "max_length": 20, "default": "draft", "read_only": true,
      "choices": [["draft", "Draft"], ["invalid", "Invalid"], ["valid", "Valid"], ["approved", "Approved"], ["superseded", "Superseded"]] },
    { "name": "source", "label": "Source", "type": "choice", "max_length": 20, "default": "claude", "read_only": true,
      "choices": [["claude", "Generated by LLM"], ["example", "Bundled example"], ["manual", "Manual"]] },
    { "name": "model", "label": "Model", "type": "string", "max_length": 100, "read_only": true },
    { "name": "summary", "label": "Summary", "type": "string", "max_length": 8000, "read_only": true },
    { "name": "blueprint_json", "label": "Blueprint JSON", "type": "string", "max_length": 1000000 },
    { "name": "validation_errors", "label": "Validation errors", "type": "string", "max_length": 65000, "read_only": true },
    { "name": "validation_warnings", "label": "Validation warnings", "type": "string", "max_length": 65000, "read_only": true }
  ]
}
