    { "name": "description", "label": "Description", "type": "string", "max_length": 1000 },
    { "name": "system_text", "label": "System prompt", "type": "string", "max_length": 65000 },
    { "name": "user_text", "label": "User prompt", "type": "string", "max_length": 65000 }
  ]
}
