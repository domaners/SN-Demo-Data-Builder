<?xml version="1.0" encoding="UTF-8"?>
<database>
    <element label="Generation Job" max_length="40" name="x_ddb_generation_job" type="collection">
        <element display="true" label="Name" max_length="160" name="name" read_only="true" type="string"/>
        <element choice="1" label="Type" max_length="20" name="type" read_only="true" type="string"/>
        <element label="Scenario" max_length="32" name="scenario" read_only="true" reference="x_ddb_scenario" type="reference"/>
        <element label="Blueprint" max_length="32" name="blueprint" read_only="true" reference="x_ddb_blueprint" type="reference"/>
        <element choice="1" default="queued" label="State" max_length="20" name="state" read_only="true" type="string"/>
        <element label="Phases" max_length="400" name="phases" read_only="true" type="string"/>
        <element label="Phase" max_length="40" name="phase" read_only="true" type="string"/>
        <element label="Phase index" max_length="40" name="phase_index" read_only="true" type="integer"/>
        <element label="Position" max_length="40" name="position" read_only="true" type="integer"/>
        <element label="Total" max_length="40" name="total" read_only="true" type="integer"/>
        <element label="Progress %" max_length="40" name="progress" read_only="true" type="integer"/>
        <element label="Attempt" max_length="40" name="attempt" read_only="true" type="integer"/>
        <element label="Next run" max_length="40" name="next_run" read_only="true" type="glide_date_time"/>
        <element label="Started" max_length="40" name="started" read_only="true" type="glide_date_time"/>
        <element label="Finished" max_length="40" name="finished" read_only="true" type="glide_date_time"/>
        <element label="Input tokens" max_length="40" name="tokens_in" read_only="true" type="integer"/>
        <element label="Output tokens" max_length="40" name="tokens_out" read_only="true" type="integer"/>
        <element label="Estimated cost (USD)" max_length="15" name="cost" read_only="true" type="decimal"/>
        <element label="Record counts" max_length="8000" name="counts" read_only="true" type="string"/>
        <element label="Error" max_length="4000" name="error" read_only="true" type="string"/>
        <element label="Log" max_length="65000" name="log" read_only="true" type="string"/>
        <element label="State data" max_length="8000" name="state_data" read_only="true" type="string"/>
    </element>
</database>
