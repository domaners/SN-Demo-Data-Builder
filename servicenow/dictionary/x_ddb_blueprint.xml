<?xml version="1.0" encoding="UTF-8"?>
<database>
    <element label="Blueprint" max_length="40" name="x_ddb_blueprint" type="collection">
        <element display="true" label="Name" max_length="120" name="name" type="string"/>
        <element label="Scenario" mandatory="true" max_length="32" name="scenario" reference="x_ddb_scenario" type="reference"/>
        <element label="Version" max_length="40" name="version" read_only="true" type="integer"/>
        <element choice="1" default="draft" label="State" max_length="20" name="state" read_only="true" type="string"/>
        <element choice="1" default="claude" label="Source" max_length="20" name="source" read_only="true" type="string"/>
        <element label="Model" max_length="100" name="model" read_only="true" type="string"/>
        <element label="Summary" max_length="8000" name="summary" read_only="true" type="string"/>
        <element label="Blueprint JSON" max_length="1000000" name="blueprint_json" type="string"/>
        <element label="Validation errors" max_length="65000" name="validation_errors" read_only="true" type="string"/>
        <element label="Validation warnings" max_length="65000" name="validation_warnings" read_only="true" type="string"/>
    </element>
</database>
