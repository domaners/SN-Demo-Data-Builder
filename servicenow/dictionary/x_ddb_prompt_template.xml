        <element default="true" label="Active" max_length="40" name="active" type="boolean"/>
        <element choice="1" label="Purpose" max_length="40" name="purpose" type="string"/>
        <element label="Description" max_length="1000" name="description" type="string"/>
        <element label="System prompt" max_length="65000" name="system_text" type="string"/>
        <element label="User prompt" max_length="65000" name="user_text" type="string"/>
    </element>
</database>
